# Copy to .env and set a long random token:   openssl rand -hex 24
SUBSVC_AUTH_TOKEN=change-me-to-a-long-random-string

# Optional
#SUBSVC_PORT=8080
#SUBSVC_UI_PORT=9090
#SUBSVC_LOG_LEVEL=info
#SUBSVC_MAX_TEST_CONCURRENCY=20
# Name given to every config in /sub (empty = keep original names)
#SUBSVC_UI_OUTPUT_NAME=
#SUBSVC_UI_OUTPUT_NUMBERED=true
