# /etc/subsvc/subsvc.env  (chmod 640, owner root:subsvc)
# Deployment settings only. Operational settings are edited in the UI/API.
SUBSVC_LISTEN=0.0.0.0:8080
SUBSVC_AUTH_TOKEN=CHANGE-ME-openssl-rand-hex-24
SUBSVC_DATA_DIR=/var/lib/subsvc
SUBSVC_CORE_PATH=/usr/local/bin/xray
SUBSVC_LOG_LEVEL=info
#SUBSVC_MAX_TEST_CONCURRENCY=20
